# ==============================================================================
# VIDHIK — HYBRID PRODUCTION DEPLOYMENT ENVIRONMENT VARIABLES
# ==============================================================================
# Architecture:
# - Vercel  : Next.js Frontend (Server-Side API Routes)
# - Render  : Python FastAPI Retrieval API (BM25 + Qdrant Cloud + RRF)
# - Laptop  : All AI Inference (BGE-M3 Embeddings + Ollama Qwen + IndicTrans2)
# NEVER commit real credentials or production tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL — FRONTEND CONFIGURATION (Server-Side Variables Only)
# Configure in: Vercel Dashboard -> Project Settings -> Environment Variables
# ------------------------------------------------------------------------------

# URL of deployed Render Retrieval API
RETRIEVAL_DAEMON_URL=https://vidhik-retrieval.onrender.com

# Public ngrok gateway URL pointing to development laptop
AI_GATEWAY_URL=https://your-session.ngrok-free.app

# Secret token matching GATEWAY_TOKEN on your laptop
AI_GATEWAY_TOKEN=vidhik-jury-secret-token-2026

# ------------------------------------------------------------------------------
# 2. RENDER — RETRIEVAL API CONFIGURATION
# Configure in: Render Dashboard -> Web Service -> Environment
# ------------------------------------------------------------------------------

# Server binding (Render dynamically assigns PORT)
HOST=0.0.0.0
PORT=8008

# Qdrant Cloud Vector Database (Existing Validated Collection: vidhik_legal_chunks)
QDRANT_URL=https://3921ee99-e17d-4568-902d-930bd975fd67.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Laptop AI Gateway (Used by Render to request BGE-M3 query embeddings)
# Does NOT load BGE-M3 into Render memory (fits within 512MB RAM tier)
AI_GATEWAY_URL=https://your-session.ngrok-free.app
AI_GATEWAY_TOKEN=vidhik-jury-secret-token-2026
EMBEDDING_MODE=gateway

# ------------------------------------------------------------------------------
# 3. LAPTOP — LOCAL AI INFERENCE & NGROK GATEWAY
# Configure in local shell / .env before starting laptop services
# ------------------------------------------------------------------------------

# Shared secret token for the AI Gateway (enforces Bearer token on /api/*)
GATEWAY_TOKEN=vidhik-jury-secret-token-2026
AI_GATEWAY_TOKEN=vidhik-jury-secret-token-2026

# Local service endpoints on development laptop
OLLAMA_URL=http://127.0.0.1:11434
TRANSLATION_URL=http://127.0.0.1:8009
