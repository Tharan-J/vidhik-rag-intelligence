# ==============================================================================
# VIDHIK — HYBRID PRODUCTION DEPLOYMENT ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to set up environment variables for each deployment target.
# NEVER commit real credentials or production tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL — FRONTEND CONFIGURATION (Server-Side Variables Only)
# Configure in: Vercel Dashboard -> Project Settings -> Environment Variables
# ------------------------------------------------------------------------------

# URL of deployed Railway Python Backend (Retrieval + RAG API)
RETRIEVAL_DAEMON_URL=https://vidhik-backend.up.railway.app

# Public ngrok gateway URL pointing to your development laptop
AI_GATEWAY_URL=https://your-subdomain.ngrok-free.app

# Secret token matching GATEWAY_TOKEN on your laptop
AI_GATEWAY_TOKEN=vidhik-jury-secret-token-2026

# Optional: Direct public API URL for browser clients
NEXT_PUBLIC_API_URL=https://vidhik-backend.up.railway.app

# ------------------------------------------------------------------------------
# 2. RAILWAY — BACKEND & RETRIEVAL SERVICE CONFIGURATION
# Configure in: Railway Dashboard -> Service Settings -> Variables
# ------------------------------------------------------------------------------

# Server binding (Railway dynamically assigns PORT)
HOST=0.0.0.0
# PORT=8008

# Qdrant Cloud Vector Database (Existing Validated Collection)
QDRANT_URL=https://3921ee99-e17d-4568-902d-930bd975fd67.sa-east-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# AI Inference Gateway (to reach local Qwen & IndicTrans2 from Railway)
AI_GATEWAY_URL=https://your-subdomain.ngrok-free.app
AI_GATEWAY_TOKEN=vidhik-jury-secret-token-2026

# Optional: Direct translation daemon URL (if hosted separately)
# TRANSLATION_DAEMON_URL=http://127.0.0.1:8009/translate

# ------------------------------------------------------------------------------
# 3. LAPTOP — LOCAL AI INFERENCE & NGROK GATEWAY
# Used when running laptop_ai_gateway.py, translation_daemon.py, and Ollama
# ------------------------------------------------------------------------------

# Shared secret token for the AI Gateway (enforces Bearer token on /api/*)
GATEWAY_TOKEN=vidhik-jury-secret-token-2026

# Local service endpoints on development laptop
OLLAMA_URL=http://127.0.0.1:11434
TRANSLATION_URL=http://127.0.0.1:8009
